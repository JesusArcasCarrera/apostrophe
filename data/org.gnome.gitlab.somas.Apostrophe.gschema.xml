<?xml version="1.0" encoding="utf-8"?>

<schemalist>

  <enum id='org.gnome.gitlab.somas.Apostrophe.Stat'>
    <value nick='characters' value='0' />
    <value nick='words' value='1' />
    <value nick='sentences' value='2' />
    <value nick='paragraphs' value='3' />
    <value nick='read_time' value='4' />
  </enum>

  <enum id='org.gnome.gitlab.somas.Apostrophe.PreviewMode'>
    <value nick='full-width' value='0' />
    <value nick='half-width' value='1' />
    <value nick='half-height' value='2' />
    <value nick='windowed' value='3' />
  </enum>

  <enum id='org.gnome.gitlab.somas.Apostrophe.PreviewSecurity'>
    <value nick='ask' value='0' />
    <value nick='always-restricted' value='1' />
    <value nick='always-unrestricted' value='2' />
  </enum>

  <schema path="/org/gnome/gitlab/somas/Apostrophe/" id="org.gnome.gitlab.somas.Apostrophe">
    <key name="window-width" type="i">
      <default>1000</default>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
    </key>
    <key name="is-fullscreen" type="b">
      <default>false</default>
    </key>
    <key name='color-scheme' type='s'>
      <choices>
        <choice value="system"/>
        <choice value="light"/>
        <choice value="dark"/>
        <choice value="sepia"/>
      </choices>
      <default>"system"</default>
      <summary>Color scheme</summary>
      <description>
        Use the color scheme in the application's UI and in the text area.
      </description>
    </key>
    <key name='spellcheck' type='b'>
      <default>true</default>
      <summary>Check spelling while typing</summary>
      <description>
        Enable or disable spellchecking.
      </description>
    </key>
    <key name='rich-editing' type='b'>
      <default>true</default>
      <summary>Rich editing</summary>
      <description>
        Present Markdown formatting while keeping source syntax editable.
      </description>
    </key>
    <key name='typewriter-sounds' type='b'>
      <default>false</default>
      <summary>Typewriter sounds</summary>
      <description>
        Play a soft mechanical click while typing.
      </description>
    </key>
    <key name='typewriter-sound' type='s'>
      <choices>
        <choice value="classic"/>
        <choice value="soft"/>
        <choice value="electric"/>
      </choices>
      <default>"classic"</default>
      <summary>Typewriter sound style</summary>
      <description>
        Sound style used for key presses and carriage returns.
      </description>
    </key>
    <key name='typewriter-volume' type='i'>
      <range min='0' max='100'/>
      <default>45</default>
      <summary>Typewriter sound volume</summary>
      <description>
        Playback volume for typewriter sounds, from 0 to 100.
      </description>
    </key>
    <key name='sync-scroll' type='b'>
      <default>true</default>
      <summary>Synchronize editor/preview scrolling</summary>
      <description>
        Keep the editor and preview scroll positions in sync.
      </description>
    </key>
    <key name='input-format' type='s'>
      <default>"markdown"</default>
      <summary>Input format</summary>
      <description>
        Input format to use when previewing and exporting using Pandoc.
      </description>
    </key>
    <key name='autohide-headerbar' type='b'>
      <default>true</default>
      <summary>Autohide Headerbar</summary>
      <description>
        Hide the header and status bars when typing.
      </description>
    </key>
    <key name='stat-default' enum='org.gnome.gitlab.somas.Apostrophe.Stat'>
      <default>"words"</default>
      <summary>Default statistic</summary>
      <description>
        Which statistic is shown on the main window.
      </description>
    </key>
    <key name='characters-per-line' type='i'>
      <default>66</default>
      <summary>Characters per line</summary>
      <description>
        Maximum number of characters per line within the editor.
      </description>
    </key>
    <key name='hemingway-mode' type='b'>
      <default>false</default>
      <summary>Hemingway Mode</summary>
      <description>
        Whether the user can delete text or not.
      </description>
    </key>
    <key name='hemingway-toast-count' type='i'>
      <default>0</default>
      <summary>Hemingway Toast Count</summary>
      <description>
        Number of times the Hemingway Toast has been shown
      </description>
    </key>
    <key name='preview-mode' enum='org.gnome.gitlab.somas.Apostrophe.PreviewMode'>
      <default>"full-width"</default>
      <summary>Preview mode</summary>
      <description>
        How to display the preview.
      </description>
    </key>
    <key name='preview-security' enum='org.gnome.gitlab.somas.Apostrophe.PreviewSecurity'>
      <default>"ask"</default>
      <summary>Preview Security</summary>
      <description>
        Security policy to apply when rendering files.
      </description>
    </key>
    <key name='preview-active' type='b'>
      <default>false</default>
      <summary>Preview active</summary>
      <description>
        Whether showing of preview is active when launching a new window.
      </description>
    </key>
    <key name='bigger-text' type='b'>
      <default>false</default>
      <summary>Text size</summary>
      <description>
        Preferred relative size for the text.
      </description>
    </key>
    <key name='toolbar-active' type='b'>
      <default>false</default>
      <summary>Toolbar</summary>
      <description>
        Whether the toolbar is shown or not.
      </description>
    </key>
    <key name='autosave-period' type='i'>
      <default>5</default>
      <summary>Number of seconds between autosaves</summary>
      <description>
        Number of seconds between autosaves
      </description>
    </key>

  </schema>

</schemalist>
